{
  "name": "hermes-skills-sync",
  "version": "1.3.0",
  "type": "module",
  "description": "Discovers Hermes skills on this machine and imports them into DSH as global or project skills.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Hochan",
  "homepage": "https://github.com/Hochan666/hermes-skills-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hochan666/hermes-skills-sync.git"
  },
  "bugs": {
    "url": "https://github.com/Hochan666/hermes-skills-sync/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "hermes",
    "skills",
    "plugin",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test-host.mjs && node test-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
